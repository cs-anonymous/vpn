<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.a.vpn-health</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/a./vpn/start_cli.sh</string>
    <string>health-probe</string>
  </array>

  <!-- launchd 的 PATH 极简，必须显式补上 python3 / curl 所在目录 -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/a./.workbuddy/binaries/python/versions/3.13.12/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/a.</string>
  </dict>

  <!-- 每 60 秒采样一次 -->
  <key>StartInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/a./vpn/health.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/a./vpn/health.launchd.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
