# ── 机密：绝对不要进公开仓库 ─────────────────────────────
# .env 是阿里云 DashScope API Key，与 VPN 无关
.env
# 本机工作日志 / 自动化记录，含个人上下文
.workbuddy/

# ── 运行时产物（每次启动重新生成）────────────────────────
config.json
selected_node.txt
xray.pid
nodes.json
.start_cli.lock/

# ── 日志：全部集中在 logs/，整目录忽略（用 .gitkeep 占位）──
# 包含 health.log（含节点行号）、vpn.log（操作流水）、xray.log、cron.log
# 以及轮换产物 cron.log.1
logs/*
!logs/.gitkeep
*.log

# ── 定时任务产物 ─────────────────────────────────────────
# vpn-cron.sh 写日志（cron.log），install-cron.sh 备份原 crontab，
# start_cli.sh 在 Linux 上生成 proxy.env
crontab.backup.*
proxy.env

# ── 备份与历史副本 ───────────────────────────────────────
*.bak
*.bak.*
*.bac
*.bak_hk_remove
start_cli_0908.sh

# ── Python 缓存 ──────────────────────────────────────────
__pycache__/
*.pyc

# ── 二进制与地理数据：已入库，clone 后直接用 ─────────────
# xray / xray-linux-64 / geoip.dat / geosite.dat / Xray-*.zip
# 故意不忽略。若日后不想让它们进版本控制，在这里加回文件名即可，
# 但注意 git 不会因为新增 ignore 规则而移除已跟踪的文件，需先 git rm --cached。
